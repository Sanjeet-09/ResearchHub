{
  "name": "researchhub-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "ResearchHub OS - Monorepo for Cloud-Native Research Management Platform",
  "workspaces": [
    "shared",
    "frontend",
    "services/*"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "build:frontend": "npm run build --workspace=frontend",
    "dev:auth": "node services/auth/src/index.js",
    "dev:gateway": "node services/gateway/src/index.js",
    "dev:project": "node services/project/src/index.js",
    "dev:experiment": "node services/experiment/src/index.js",
    "dev:dataset": "node services/dataset/src/index.js",
    "dev:document": "node services/document/src/index.js",
    "dev:publication": "node services/publication/src/index.js",
    "dev:equipment": "node services/equipment/src/index.js",
    "dev:activity": "node services/activity/src/index.js",
    "dev:notification": "node services/notification/src/index.js",
    "db:setup": "node scripts/db-init.js",
    "test": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
