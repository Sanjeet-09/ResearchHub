# ==============================================================================
# ResearchHub OS - Global Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL / Supabase / Cloud SQL / Local Docker)
# ------------------------------------------------------------------------------
# Every microservice supports EITHER:
# Option A: Single DATABASE_URL connection string (Recommended for Supabase)
# Supabase Direct:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.vghvqjkeicoopaeisnnv.supabase.co:5432/postgres
# Supabase Connection Pooler (Transaction Mode - port 6543):
# DATABASE_URL=postgresql://postgres.vghvqjkeicoopaeisnnv:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Supabase Connection Pooler (Session Mode - port 5432):
# DATABASE_URL=postgresql://postgres.vghvqjkeicoopaeisnnv:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Local Docker:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/researchhub

# Option B: Individual database connection variables
# DB_HOST=db.vghvqjkeicoopaeisnnv.supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=[YOUR-PASSWORD]
# DB_NAME=postgres
# DB_SSL=true

# Connection Pool Settings
DB_MAX_POOL=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=10000

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://vghvqjkeicoopaeisnnv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_QSrXsjYicarUAyVl_0n2zA_ovOzwAXO
# Optional Service Role Key for backend administration (keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=

# Frontend Vite aliases (synced with NEXT_PUBLIC_* variables)
VITE_SUPABASE_URL=https://vghvqjkeicoopaeisnnv.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_QSrXsjYicarUAyVl_0n2zA_ovOzwAXO

# ------------------------------------------------------------------------------
# 3. Security & Application Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
JWT_SECRET=researchhub-dev-secret-key-32-chars-minimum!!

# ------------------------------------------------------------------------------
# 4. Frontend Configuration
# ------------------------------------------------------------------------------
# Primary API base points to API Gateway (keeping routing and RBAC checks intact)
# Local: http://localhost:5000/api
# Production: /api (Cloud Run / Firebase Hosting rewrite)
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 5. Service Ports
# ------------------------------------------------------------------------------
PORT=5000
PORT_AUTH=5001
PORT_PROJECT=5002
PORT_EXPERIMENT=5003
PORT_DATASET=5004
PORT_DOCUMENT=5005
PORT_PUBLICATION=5006
PORT_EQUIPMENT=5007
PORT_ACTIVITY=5008
PORT_NOTIFICATION=5009
PORT_LAB=5010
